# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle's own build output — separate from Flutter's top-level /build/
# above, and not covered by it. android/app/build/ already gets caught by
# the debug/profile/release lines above for typical outputs, but
# android/build/ (module-root Gradle output, e.g. lint/problems reports)
# was leaking through uncaught.
/android/.gradle/
/android/build/
/android/app/build/

# Android — machine-specific SDK paths, regenerated automatically on the
# next `flutter pub get`/build. NEVER share this file as-is; a new dev's
# copy will point at their own SDK/Flutter install paths.
android/local.properties
**/android/local.properties

# Android release signing — none of these exist yet (release builds
# currently fall back to the debug signing config, see android/app/
# build.gradle), but keeping this in place preempts ever committing a
# real keystore/credentials once one is added.
android/key.properties
**/*.jks
**/*.keystore

# iOS/CocoaPods — regenerated by `pod install` / `flutter build`.
**/ios/Flutter/ephemeral/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/*.xcuserstate
**/xcuserdata/

# macOS/Linux/Windows desktop targets — same idea, ephemeral/generated.
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

# Older Flutter SDKs still generate this alongside the already-ignored
# .flutter-plugins-dependencies above.
.flutter-plugins

# Firebase config — NOT committed here since these carry this org's live
# Firebase project identifiers (see the note below this file about handing
# them to another dev out-of-band instead).
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

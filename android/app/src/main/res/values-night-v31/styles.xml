<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same as values-v31/styles.xml, deliberately forced to the light/white
         variant even when the system is in dark mode — see
         values-night/styles.xml's doc comment for why: the app has no real
         dark theme, so a black Android-12+ splash background would read as
         a jarring flash before our own always-light `SplashScreen` takes over. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app has no real dark theme (AppTheme only defines `light` —
         see lib/core/theme/app_theme.dart) and always renders light
         regardless of the system setting. This used to stay
         Theme.Black.NoTitleBar for a device in system dark mode, which made
         the OS's pre-Flutter splash window (and its mandatory Android 12+
         launcher-icon splash) render on a BLACK background instead of the
         white our own `SplashScreen`/`PypeLogoReveal` immediately paints —
         a jarring black-flash-then-white handoff. Matching the light theme
         here instead makes the native splash always white, so it hands off
         to our in-Flutter animation invisibly. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) shows its OWN mandatory splash screen before
         the app's process/window even exists, separate from and in
         addition to `launch_background.xml`/`LaunchTheme` above — by
         default it renders the app's launcher icon centered on a
         background color. Without this override it showed
         `@mipmap/launcher_icon` (see AndroidManifest.xml) right before our
         own `PypeLogoReveal` opening animation, i.e. exactly the
         "logo on a screen, then our animation" the app should not do —
         the intent is ONLY our in-Flutter animation on first load.
         `windowSplashScreenAnimatedIcon` is set to a fully transparent 1x1
         drawable (can't be entirely omitted — the OS still requires an
         icon resource) so nothing visibly renders on top of the white
         `windowSplashScreenBackground`, which then hands off straight to
         `SplashScreen`'s white Scaffold with no visible seam. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
